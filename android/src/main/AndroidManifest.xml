<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The link with TitanKeys. TitanKeys declares the same permission, so either app can be installed first. Only apps
         signed with the same key can hold it. -->
    <permission
        android:name="com.everyonesniche.titantools.permission.LINK"
        android:label="Talk to Titan Tools"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.everyonesniche.titantools.permission.LINK" />
    <!-- The helper apps open Titan Tools' actions with this. They declare it too, so install order doesn't matter. -->
    <permission
        android:name="com.everyonesniche.titantools.permission.TRIGGER"
        android:label="Open Titan Tools' actions"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.everyonesniche.titantools.permission.TRIGGER" />
    <!-- Installs the helper apps that come inside Titan Tools, when asked. Android asks first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Widget buttons host any app's widget, which draws with that app's own resources: Titan Tools must see the app.
         Matching widget apps by intent wasn't enough on Android 16. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android's own uninstall prompt for the three old apps. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-feature android:name="android.hardware.sensor.light" android:required="false" />
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.titankeys" />
        <package android:name="com.everyonesniche.nightkeys" />
        <package android:name="dev.everyonesniche.scaletoggle" />
        <package android:name="com.jasonlok.titanhold" />
        <package android:name="com.agui.shortcutsettings" />
        <package android:name="com.everyonesniche.titantools.layout" />
        <package android:name="com.everyonesniche.titantools.rotate" />
        <package android:name="com.everyonesniche.titantools.flashlight" />
        <package android:name="com.everyonesniche.titantools.night" />
        <package android:name="com.everyonesniche.titantools.playpause" />
        <package android:name="com.everyonesniche.titantools.widget1" />
        <package android:name="com.everyonesniche.titantools.widget2" />
        <package android:name="com.everyonesniche.titantools.widget3" />
        <package android:name="com.everyonesniche.titantools.widget4" />
        <package android:name="com.everyonesniche.titantools.widget5" />
        <package android:name="com.android.vending" />
        <!-- Widget buttons: every app with a widget, so its widget can draw here (without this, 1Valet's couldn't). -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <application>
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <provider
            android:name="com.everyonesniche.titantools.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity
            android:name="com.everyonesniche.titantools.scale.ScaleActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.everyonesniche.titantools.scale"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection" />
        <activity
            android:name="com.everyonesniche.titantools.rotate.RotateActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.everyonesniche.titantools.rotate"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection" />
        <activity
            android:name="com.everyonesniche.titantools.quick.FlashlightActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.everyonesniche.titantools.flashlight"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection" />
        <activity
            android:name="com.everyonesniche.titantools.quick.NightModeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.everyonesniche.titantools.night"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection" />
        <activity
            android:name="com.everyonesniche.titantools.quick.PlayPauseActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.everyonesniche.titantools.play"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection" />
        <activity
            android:name="com.everyonesniche.titantools.quick.WidgetButtonActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.everyonesniche.titantools.widget"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection" />
        <!-- Widget button's setup: pick a widget, then the button. -->
        <activity
            android:name="com.everyonesniche.titantools.quick.WidgetSetupActivity"
            android:exported="false"
            android:label="Widget button"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- The one-press actions, opened by the helper apps (one tiny app each, which Shortcut keys can pick) and by Titan
             Tools' Android shortcuts. Only apps signed with the same key may open it. -->
        <activity
            android:name="com.everyonesniche.titantools.quick.TriggerActivity"
            android:exported="true"
            android:permission="com.everyonesniche.titantools.permission.TRIGGER"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.everyonesniche.titantools.trigger"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.everyonesniche.titantools.action.TRIGGER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Titan Tools' Android shortcuts, for the places that take one. -->
        <activity
            android:name="com.everyonesniche.titantools.quick.CreateShortcutActivity"
            android:exported="true"
            android:label="Titan Tools"
            android:icon="@mipmap/ic_launcher"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver android:name="com.everyonesniche.titantools.quick.HelperApps$Result" android:exported="false" />
        <service
            android:name="com.everyonesniche.titantools.light.LightService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled, continuous ambient-light monitoring that turns the physical keyboard backlight on in the dark and off when bright or when the screen turns off." />
        </service>
        <service
            android:name="com.everyonesniche.titantools.hold.HoldService"
            android:label="Titan Tools: Hold Symbols"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/hold_service" />
        </service>
        <receiver
            android:name="com.everyonesniche.titantools.light.LinkReceiver"
            android:exported="true"
            android:permission="com.everyonesniche.titantools.permission.LINK">
            <intent-filter>
                <action android:name="com.everyonesniche.titantools.action.TYPING" />
            </intent-filter>
        </receiver>
        <receiver android:name="com.everyonesniche.titantools.core.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
